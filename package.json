{
	"name": "vscode-resx-editor",
	"displayName": "ResX Editor",
	"description": "ResX Editor",
	"version": "0.1.0",
	"engines": {
		"vscode": "^1.49.0"
	},
	"publisher": "DominicVonk",
	"categories": [
		"Other"
	],
	"keywords": [
		"resx",
		"resw"
	],
	"activationEvents": [
		"onCustomEditor:resx.editor",
		"onCommand:resx.openGitDiff",
		"onCommand:resx.openXml",
		"onLanguage:xml"
	],
	"bugs": {
		"url": "https://github.com/DominicVonk/vscode-resx/issues"
	},
	"license": "MIT",
	"galleryBanner": {
		"color": "#fff",
		"theme": "light"
	},
	"icon": "resx.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/DominicVonk/vscode-resx.git"
	},
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "resx.editor",
				"displayName": "ResX",
				"selector": [
					{
						"filenamePattern": "*.resx"
					},
					{
						"filenamePattern": "*.resw"
					}
				],
				"priority": "default"
			}
		],
		"languages": [
			{
				"id": "xml",
				"extensions": [
					".resx",
					".resw"
				]
			}
		],
		"configuration": {
			"title": "ResX Editor",
			"properties": {
				"resx.sortOnSave": {
					"type": "boolean",
					"default": false,
					"description": "Sort resource entries alphabetically by key when saving .resx and .resw files."
				}
			}
		},
		"commands": [
			{
				"command": "resx.openGitDiff",
				"title": "ResX: Compare with Git HEAD"
			},
			{
				"command": "resx.openXml",
				"title": "ResX: Open as XML"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "resx.openGitDiff",
					"when": "resourceExtname == .resx || resourceExtname == .resw",
					"group": "navigation"
				},
				{
					"command": "resx.openXml",
					"when": "resourceExtname == .resx || resourceExtname == .resw",
					"group": "navigation"
				}
			],
			"editor/title/context": [
				{
					"command": "resx.openGitDiff",
					"when": "resourceExtname == .resx || resourceExtname == .resw",
					"group": "navigation"
				},
				{
					"command": "resx.openXml",
					"when": "resourceExtname == .resx || resourceExtname == .resw",
					"group": "navigation"
				}
			],
			"scm/resourceState/context": [
				{
					"command": "resx.openGitDiff",
					"when": "resourceExtname == .resx || resourceExtname == .resw",
					"group": "navigation"
				},
				{
					"command": "resx.openXml",
					"when": "resourceExtname == .resx || resourceExtname == .resw",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js",
		"test:unit": "npm run compile && mocha test/*.test.js"
	},
	"devDependencies": {
		"@types/glob": "^7.1.1",
		"@types/mocha": "^7.0.2",
		"@types/node": "^13.11.0",
		"@types/sax": "^1.2.7",
		"@types/vscode": "^1.49.0",
		"@typescript-eslint/eslint-plugin": "^2.30.0",
		"@typescript-eslint/parser": "^2.30.0",
		"eslint": "^6.8.0",
		"glob": "^7.1.6",
		"jsdom": "^26.1.0",
		"mocha": "^7.1.2",
		"typescript": "^3.8.3",
		"vscode-test": "^1.3.0"
	},
	"dependencies": {
		"sax": "^1.6.1"
	}
}
